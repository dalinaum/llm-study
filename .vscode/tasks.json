{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "uv run current file",
      "type": "shell",
      "command": "uv",
      "args": ["run", "python", "${file}"],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
